<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple News Website</title>
</head>

<body>

    <header>
        <h1>Global Daily News</h1>
        <p>Your Trusted Source for Latest Updates</p>

        <nav>
            <a href="#world">World</a> |
            <a href="#sports">Sports</a> |
            <a href="#entertainment">Entertainment</a> |
            <a href="#podcast">Podcast</a> |
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <hr>

    <section id="world">
        <h2>World News</h2>
        <p>
            Today's top headline: Global leaders meet to discuss
            climate change initiatives.
        </p>

        <a href="https://bbc.com/news/world-us-canada-40297983" target="_blank">
            Read more on BBC
        </a>
    </section>

    <hr>

    <section id="sports">
        <h2>Sports Update</h2>
        <p>
            Highlights of yesterday's football match with thrilling
            last-minute goals!
        </p>
    </section>

    <hr>

    <section id="entertainment">
        <h2>Entertainment Buzz</h2>
        <p>
            New movie trailer released today. Fans are excited!
        </p>
    </section>

    <hr>

    <section id="podcast">
        <h2>News Podcast</h2>
        <p>Listen to today's top headlines:</p>

        <audio controls>
            <source src="podcast.mp3" type="audio/mpeg">
            Your browser does not support the audio element.
        </audio>
    </section>

    <hr>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>Email: info@globalnews.com</p>
    </section>

    <footer>
        <p>&copy; 2025 Global Daily News</p>
    </footer>

</body>
</html>
